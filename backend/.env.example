# LLM (Gemini 2.5 Flash via LiteLLM)
GEMINI_API_KEY=your_api_key
LLM_MODEL=gemini/gemini-2.5-flash

# Runtime query embeddings — Gemini preferred (no local models)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_PROVIDER=gemini

# Fallback for bge-m3 Qdrant vectors
HF_INFERENCE_API_KEY=your_api_key

# Qdrant Cloud
QDRANT_URL=your_qdrant_url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=travel_knowledge

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<useranme>:<password>@travel-planner-cluster.tg0jq0z.mongodb.net/?appName=Travel-Planner-Cluster
MONGODB_DB=travel_planner

# External Tools
OPENWEATHER_API_KEY=your_openweather_api_key
EXCHANGERATE_API_KEY=your_exchangerate_api_key
TAVILY_API_KEY=your_tavily_api_key

# App settings
CORS_ORIGINS=http://localhost:5173,https://your-app.netlify.app
CHAT_TIMEOUT_SECONDS=120
MAX_CONVERSATION_TURNS=8

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=travel-planner
